# Your physical RoboRacer. Checked working 2026-09-22.
CAR_HOST="192.168.1.145"          # Wi-Fi address. NOTE: 192.168.0.x is the lidar's own wired net, not this
CAR_USER="swat-roboracer-2026"
CAR_WS="~/f1tenth_ws"             # workspace on the car (src/: f1tenth_system, auto, pid_msgs)
CAR_ODOM="/odom"
CAR_RMW="rmw_cyclonedds_cpp"      # the car's stack uses CycloneDDS; FastDDS crashes it with std::bad_alloc
# CAR_ROS_SETUP="/opt/ros/foxy/setup.bash"   # car runs Ubuntu 20.04 + ROS 2 Foxy
# CAR_BRINGUP="ros2 launch f1tenth_stack bringup_launch.py"
#
# SAFETY: this car's mux has no autonomous lock. Anything published on /drive moves the car
# immediately, with no button held. Stop with: rr car-stop  (or Ctrl-C in the rr car-run terminal).
